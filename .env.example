# Másold le .env néven, és írd át a jelszavakat!
#   cp .env.example .env

# Felhasználók: Név:jelszó, vesszővel elválasztva (a jelszóban ne legyen vessző)
APP_USERS=Tibi:IdeIrdAJelszot1,Évi:IdeIrdAJelszot2

# A "Kié?" mező alapértelmezett választható értékei
OWNERS=Tibi,Évi,Közös,Család

# Munkamenet titkos kulcs (ha üres, automatikusan generál egyet a /data mappába)
SECRET_KEY=

# 1 = a bejelentkezési süti csak HTTPS-en megy (csak akkor kapcsold be, ha
#     kizárólag a Cloudflare-es https címen használjátok, helyi http címen nem)
COOKIE_SECURE=0

# Hálózati megosztáson (NFS/SMB) hagyd DELETE-en! (WAL ott nem biztonságos)
SQLITE_JOURNAL_MODE=DELETE

# A közös e-könyv mappa (docker-compose.yml-ben csatolva) átvizsgálása ennyi óránként
LIBRARY_SCAN_HOURS=6

# Hány napi mentést tartson meg a /data/backups mappában
BACKUP_KEEP=30

# Opcionális: ingyenes Google Books API kulcs (kulcs nélkül gyakran "429 Too Many Requests")
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Opcionális: Claude AI kulcs a borítókép-felismeréshez és a nehezen található
# könyvek webes kereséséhez (https://console.anthropic.com). Üresen is működik.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
